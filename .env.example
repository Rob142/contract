# ─────────────────────────────────────────────────────────────
# 로컬 개발 설정. 이 파일을 복사해 .env를 만든다 (.env는 절대 커밋하지 않는다)
# 포트·주소는 각자 컴퓨터에 맞게 .env에서만 바꾼다. docker-compose.yml은 고치지 않는다.
# ─────────────────────────────────────────────────────────────

# DB 계정. 비밀번호는 사람마다 무작위로 만든다 (AGENTS.md 3단계)
POSTGRES_DB=freelance_hub
POSTGRES_USER=freelance_hub
POSTGRES_PASSWORD=change-me

# 내 컴퓨터에서 쓰는 포트. 다른 프로그램이 이미 쓰고 있으면 비어 있는 번호로 바꾼다
POSTGRES_PORT=5442
API_PORT=8010
WEB_PORT=5173

# 접속 범위. 127.0.0.1 = 내 컴퓨터에서만 / 0.0.0.0 = 같은 와이파이의 휴대폰·다른 컴퓨터에서도
WEB_BIND=127.0.0.1

# 윈도우는 true (코드를 고치면 바로 반영되게). 맥은 false
FILE_POLLING=false

# (선택) 컨테이너 밖에서 DB 도구로 접속할 때 쓰는 주소. 비밀번호·포트를 위와 맞춘다
DATABASE_URL=postgresql://freelance_hub:change-me@127.0.0.1:5442/freelance_hub

# AI 모델과 API 키는 웹 화면의 [내 정보와 설정 → AI 설정]에서 각자 등록한다
